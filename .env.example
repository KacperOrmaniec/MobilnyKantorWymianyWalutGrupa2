# Skopiuj do .env i uzupełnij. Plik .env NIE trafia do repo.
POSTGRES_DB=kantor
POSTGRES_USER=kantor
POSTGRES_PASSWORD=change_me #haslo do bazy danych
POSTGRES_PORT=5432
PGADMIN_PASSWORD=TwojeSilneHaslo #haslo do interfejsu graficznego bazy danych
# Klucz do podpisywania tokenów JWT, min. 32 znaki. Wygeneruj np.:
#   PowerShell: [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(48))
#   bash:       openssl rand -base64 48
JWT_KEY=zmien_mnie_na_losowy_klucz_min_32_znaki
# Port API na komputerze przy docker compose (w kontenerze API słucha na 8080).
API_PORT=5171
