    {
      "name": "historyczne kursy EUR z zakresu dat",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/kursy/historyczne?waluta=EUR&od={{od}}&do={{do}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "kursy",
            "historyczne"
          ],
          "query": [
            {
              "key": "waluta",
              "value": "EUR"
            },
            {
              "key": "od",
              "value": "{{od}}"
            },
            {
              "key": "do",
              "value": "{{do}}"
            }
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const end = new Date();",
              "end.setUTCDate(end.getUTCDate() - 1);",
              "const start = new Date(end);",
              "start.setUTCDate(start.getUTCDate() - 13);",
              "pm.variables.set(\"od\", start.toISOString().slice(0, 10));",
              "pm.variables.set(\"do\", end.toISOString().slice(0, 10));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5171",
      "type": "string"
    }
  ]
}
